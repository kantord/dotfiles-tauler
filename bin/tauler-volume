#!/usr/bin/env bash
# Default audio sink and source volume as a tauler module: reads intents on
# stdin, writes state on stdout. Backs <OutputVolume> and <InputVolume>; copy it
# somewhere on disk (the components default to ~/.local/bin/tauler-volume) and
# make it executable. Requires wpctl (PipeWire/WirePlumber) and jq.
#
# Vocabulary (the layout holds nothing, this does):
#   {"type":"setVolume","target":"sink"|"source","volume":N}   N in 0..100
#   {"type":"toggleMute","target":"sink"|"source"}
# `target` defaults to "sink". Emits
#   {"sink":{"volume":N,"muted":bool},"source":{"volume":N,"muted":bool}}
# on start, after every intent, and every 2s so that changes made elsewhere
# (pavucontrol, media keys) still show up. A side with no default device is
# `null`.
#
# One writer only. A background poller would interleave its lines with the
# reader's, and tauler parses one JSON object per line.
set -uo pipefail

device() {
    case $1 in
    source) echo "@DEFAULT_AUDIO_SOURCE@" ;;
    *)      echo "@DEFAULT_AUDIO_SINK@" ;;
    esac
}

state() {
    local out volume muted
    out=$(wpctl get-volume "$(device "$1")" 2>/dev/null) || { echo null; return; }
    # "Volume: 1.17" or "Volume: 0.40 [MUTED]"
    volume=$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$out")
    muted=false
    [[ $out == *MUTED* ]] && muted=true
    printf '{"volume":%s,"muted":%s}' "$volume" "$muted"
}

emit() {
    printf '{"sink":%s,"source":%s}\n' "$(state sink)" "$(state source)"
}

handle() {
    local line=$1 type target volume
    type=$(jq -r 'try .type // empty' <<<"$line")
    target=$(jq -r 'try .target // "sink"' <<<"$line")
    case $type in
    setVolume)
        volume=$(jq -r 'try .volume // empty' <<<"$line")
        [[ -n $volume ]] && wpctl set-volume "$(device "$target")" "${volume}%"
        ;;
    toggleMute)
        wpctl set-mute "$(device "$target")" toggle
        ;;
    esac
}

emit
while :; do
    IFS= read -r -t 2 line
    rc=$?
    if ((rc == 0)); then
        handle "$line"
    elif ((rc > 128)); then
        : # read timed out; fall through and re-emit
    else
        # stdin closed — tauler is gone, and looping on EOF would spin a core.
        exit 0
    fi
    emit
done
